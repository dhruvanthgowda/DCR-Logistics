# DCR Logistics - Email Dispatch Configuration (Vercel Environment Variables)

# Option 1: GoDaddy Webmail SMTP (Recommended for @dcrlogistics.in)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@dcrlogistics.in
SMTP_PASS=YOUR_GODADDY_EMAIL_PASSWORD

# Option 2: Or Resend API Key (Free 3,000 emails/month from https://resend.com)
# RESEND_API_KEY=re_123456789
